// =============================================================================
// Fluff Silo System 2 - S7-1200
// FB "FB_FluffSilo" : top level, called once per scan from OB1 with "iDB_FluffSilo"
//
//   I/O (PLC tags)  ->  E-Stop latch, External Request, parameters
//                   ->  FB_Sequencer -> FB_PaddlePattern -> 9 x FB_Motor  ->  outputs
//                   ->  DB_HMI status for FluffSilo HMI2
//
// Devices: Blower01, Screw01, Paddle01..07. DB_HMI.Cfg.PaddleCount (1..7) paddles are
// installed; the others never run (FB_Motor.Installed = FALSE) and their inputs may be unwired.
//
// Configuration: static variables marked [CFG] - change their start values in
// "iDB_FluffSilo" (or online). See README section "Options".
// =============================================================================
FUNCTION_BLOCK "FB_FluffSilo"
TITLE = 'Fluff Silo System 2'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR
      FbTimeout : Time := T#3S;              // [CFG] running feedback supervision
      SafeInterlock : Bool := FALSE;         // [CFG] TRUE: Interlock also blocks Manual Start
      RestartAfterBlowerTrip : Bool := TRUE; // [CFG] FALSE: a Blower01 trip ends Auto mode
      FillOnLevel : Real := 25.0;            // [CFG] % - Fill_Request ON below this level
      FillOffLevel : Real := 90.0;           // [CFG] % - Fill_Request OFF at this level
      EStopLatch : Bool;                     // E-Stop latched (until reset)
      FillReq : Bool;
      LevelPct : Real;                       // silo level 0..100 %
      LevelSensorFault : Bool;
      AnyFault : Bool;
      rtReset : R_TRIG;
      Seq : "FB_Sequencer";
      Pattern : "FB_PaddlePattern";
      Blower01 : "FB_Motor";
      Screw01 : "FB_Motor";
      Paddle01 : "FB_Motor";
      Paddle02 : "FB_Motor";
      Paddle03 : "FB_Motor";
      Paddle04 : "FB_Motor";
      Paddle05 : "FB_Motor";
      Paddle06 : "FB_Motor";
      Paddle07 : "FB_Motor";
   END_VAR

   VAR_TEMP
      resetPulse : Bool;
      extReq : Bool;
      cmdStart : Bool;
      cmdStop : Bool;
      avail : Array[0..6] of Bool;
      tBlowerToScrew : Time;
      tReqHold : Time;
      tScrewToPaddle : Time;
      tReqOffScrewStop : Time;
      tScrewTripBlower : Time;
      tAutoStopBlower : Time;
      nPad : Int;
      i : Int;
   END_VAR


BEGIN
	REGION E-Stop and reset
	    // Hardware E-Stop (safety relay, NC) or HMI E-Stop -> latched until Reset
	    // NOTE: the safety relay must switch off the contactors by hardware.
	    //       The PLC only follows it (category / PL according to the risk assessment).
	    #rtReset(CLK := "PB_Reset" OR "DB_HMI".Cmd.ResetEStop);
	    #resetPulse := #rtReset.Q;
	    IF NOT "EStop_OK" OR "DB_HMI".Cmd.EStop THEN
	        #EStopLatch := TRUE;
	    END_IF;
	    IF #resetPulse AND "EStop_OK" AND NOT "DB_HMI".Cmd.EStop THEN
	        #EStopLatch := FALSE;
	    END_IF;
	END_REGION

	REGION External Request and parameters
	    // External Request = hardware input from the consumer OR the HMI button
	    #extReq := "ExtRequest_In" OR "DB_HMI".Cmd.ExtRequest;

	    "FC_ValidateParams"();
	    #nPad := "DB_HMI".Cfg.PaddleCount;   // 1..7 after FC_ValidateParams
	    #tBlowerToScrew := "FC_TenthsToTime"(Tenths := "DB_HMI".Delay[0]);
	    #tReqHold := "FC_TenthsToTime"(Tenths := "DB_HMI".Delay[1]);
	    #tScrewToPaddle := "FC_TenthsToTime"(Tenths := "DB_HMI".Delay[2]);
	    #tReqOffScrewStop := "FC_TenthsToTime"(Tenths := "DB_HMI".Delay[3]);
	    #tScrewTripBlower := "FC_TenthsToTime"(Tenths := "DB_HMI".Delay[4]);
	    #tAutoStopBlower := "FC_TenthsToTime"(Tenths := "DB_HMI".Delay[5]);
	END_REGION

	REGION Auto sequence
	    // panel Auto Stop push button is NC: wire break = stop, start refused while pressed
	    #cmdStop := "DB_HMI".Cmd.AutoStop OR NOT "PB_AutoStop";
	    #cmdStart := ("DB_HMI".Cmd.AutoStart OR "PB_AutoStart") AND NOT #cmdStop;

	    #Seq(CmdAutoStart := #cmdStart,
	         CmdAutoStop := #cmdStop,
	         EStopActive := #EStopLatch,
	         ExtRequest := #extReq,
	         BlowerRunning := "Blower01_FB",
	         ScrewRunning := "Screw01_FB",
	         TBlowerToScrew := #tBlowerToScrew,
	         TReqHold := #tReqHold,
	         TScrewToPaddle := #tScrewToPaddle,
	         TReqOffScrewStop := #tReqOffScrewStop,
	         TScrewTripBlower := #tScrewTripBlower,
	         TAutoStopBlower := #tAutoStopBlower,
	         RestartAfterBlowerTrip := #RestartAfterBlowerTrip);
	END_REGION

	REGION Paddle Patterns
	    // availability of the paddles from the previous scan (not installed = not available)
	    #avail[0] := #Paddle01.Available;
	    #avail[1] := #Paddle02.Available;
	    #avail[2] := #Paddle03.Available;
	    #avail[3] := #Paddle04.Available;
	    #avail[4] := #Paddle05.Available;
	    #avail[5] := #Paddle06.Available;
	    #avail[6] := #Paddle07.Available;

	    #Pattern(Enable := #Seq.PatternCmd,
	             Available := #avail,
	             StepCount := "DB_HMI".Pattern.StepCount,
	             Mask := "DB_HMI".Pattern.Mask,
	             StepTime := "DB_HMI".Pattern.StepTime);
	END_REGION

	REGION Devices
	    // DevCmd index = device * 8 + command
	    // command: 0 ManualStart, 1 ManualStop, 2 ReturnAuto, 3 Enable, 4 Disable, 5 ResetFault
	    #Blower01(Installed := TRUE,
	              AutoStart := #Seq.BlowerAutoStart,
	              AutoStop := #Seq.BlowerAutoStop,
	              Interlock := FALSE,
	              EStop := #EStopLatch,
	              CmdManStart := "DB_HMI".DevCmd[0],
	              CmdManStop := "DB_HMI".DevCmd[1],
	              CmdReturnAuto := "DB_HMI".DevCmd[2],
	              CmdEnable := "DB_HMI".DevCmd[3],
	              CmdDisable := "DB_HMI".DevCmd[4],
	              CmdResetFault := "DB_HMI".DevCmd[5] OR #resetPulse,
	              Feedback := "Blower01_FB",
	              OverloadOK := "Blower01_OL",
	              FbTimeout := #FbTimeout,
	              SafeInterlock := #SafeInterlock);

	    #Screw01(Installed := TRUE,
	             AutoStart := #Seq.ScrewAutoStart,
	             AutoStop := #Seq.ScrewAutoStop,
	             Interlock := #Seq.ScrewInterlock,
	             EStop := #EStopLatch,
	             CmdManStart := "DB_HMI".DevCmd[8],
	             CmdManStop := "DB_HMI".DevCmd[9],
	             CmdReturnAuto := "DB_HMI".DevCmd[10],
	             CmdEnable := "DB_HMI".DevCmd[11],
	             CmdDisable := "DB_HMI".DevCmd[12],
	             CmdResetFault := "DB_HMI".DevCmd[13] OR #resetPulse,
	             Feedback := "Screw01_FB",
	             OverloadOK := "Screw01_OL",
	             FbTimeout := #FbTimeout,
	             SafeInterlock := #SafeInterlock);

	    #Paddle01(Installed := (#nPad > 0),
	              AutoStart := #Pattern.PaddleCmd[0],
	              AutoStop := #Seq.PaddleAutoStop,
	              Interlock := #Seq.PaddleInterlock,
	              EStop := #EStopLatch,
	              CmdManStart := "DB_HMI".DevCmd[16],
	              CmdManStop := "DB_HMI".DevCmd[17],
	              CmdReturnAuto := "DB_HMI".DevCmd[18],
	              CmdEnable := "DB_HMI".DevCmd[19],
	              CmdDisable := "DB_HMI".DevCmd[20],
	              CmdResetFault := "DB_HMI".DevCmd[21] OR #resetPulse,
	              Feedback := "Paddle01_FB",
	              OverloadOK := "Paddle01_OL",
	              FbTimeout := #FbTimeout,
	              SafeInterlock := #SafeInterlock);

	    #Paddle02(Installed := (#nPad > 1),
	              AutoStart := #Pattern.PaddleCmd[1],
	              AutoStop := #Seq.PaddleAutoStop,
	              Interlock := #Seq.PaddleInterlock,
	              EStop := #EStopLatch,
	              CmdManStart := "DB_HMI".DevCmd[24],
	              CmdManStop := "DB_HMI".DevCmd[25],
	              CmdReturnAuto := "DB_HMI".DevCmd[26],
	              CmdEnable := "DB_HMI".DevCmd[27],
	              CmdDisable := "DB_HMI".DevCmd[28],
	              CmdResetFault := "DB_HMI".DevCmd[29] OR #resetPulse,
	              Feedback := "Paddle02_FB",
	              OverloadOK := "Paddle02_OL",
	              FbTimeout := #FbTimeout,
	              SafeInterlock := #SafeInterlock);

	    #Paddle03(Installed := (#nPad > 2),
	              AutoStart := #Pattern.PaddleCmd[2],
	              AutoStop := #Seq.PaddleAutoStop,
	              Interlock := #Seq.PaddleInterlock,
	              EStop := #EStopLatch,
	              CmdManStart := "DB_HMI".DevCmd[32],
	              CmdManStop := "DB_HMI".DevCmd[33],
	              CmdReturnAuto := "DB_HMI".DevCmd[34],
	              CmdEnable := "DB_HMI".DevCmd[35],
	              CmdDisable := "DB_HMI".DevCmd[36],
	              CmdResetFault := "DB_HMI".DevCmd[37] OR #resetPulse,
	              Feedback := "Paddle03_FB",
	              OverloadOK := "Paddle03_OL",
	              FbTimeout := #FbTimeout,
	              SafeInterlock := #SafeInterlock);

	    #Paddle04(Installed := (#nPad > 3),
	              AutoStart := #Pattern.PaddleCmd[3],
	              AutoStop := #Seq.PaddleAutoStop,
	              Interlock := #Seq.PaddleInterlock,
	              EStop := #EStopLatch,
	              CmdManStart := "DB_HMI".DevCmd[40],
	              CmdManStop := "DB_HMI".DevCmd[41],
	              CmdReturnAuto := "DB_HMI".DevCmd[42],
	              CmdEnable := "DB_HMI".DevCmd[43],
	              CmdDisable := "DB_HMI".DevCmd[44],
	              CmdResetFault := "DB_HMI".DevCmd[45] OR #resetPulse,
	              Feedback := "Paddle04_FB",
	              OverloadOK := "Paddle04_OL",
	              FbTimeout := #FbTimeout,
	              SafeInterlock := #SafeInterlock);

	    #Paddle05(Installed := (#nPad > 4),
	              AutoStart := #Pattern.PaddleCmd[4],
	              AutoStop := #Seq.PaddleAutoStop,
	              Interlock := #Seq.PaddleInterlock,
	              EStop := #EStopLatch,
	              CmdManStart := "DB_HMI".DevCmd[48],
	              CmdManStop := "DB_HMI".DevCmd[49],
	              CmdReturnAuto := "DB_HMI".DevCmd[50],
	              CmdEnable := "DB_HMI".DevCmd[51],
	              CmdDisable := "DB_HMI".DevCmd[52],
	              CmdResetFault := "DB_HMI".DevCmd[53] OR #resetPulse,
	              Feedback := "Paddle05_FB",
	              OverloadOK := "Paddle05_OL",
	              FbTimeout := #FbTimeout,
	              SafeInterlock := #SafeInterlock);

	    #Paddle06(Installed := (#nPad > 5),
	              AutoStart := #Pattern.PaddleCmd[5],
	              AutoStop := #Seq.PaddleAutoStop,
	              Interlock := #Seq.PaddleInterlock,
	              EStop := #EStopLatch,
	              CmdManStart := "DB_HMI".DevCmd[56],
	              CmdManStop := "DB_HMI".DevCmd[57],
	              CmdReturnAuto := "DB_HMI".DevCmd[58],
	              CmdEnable := "DB_HMI".DevCmd[59],
	              CmdDisable := "DB_HMI".DevCmd[60],
	              CmdResetFault := "DB_HMI".DevCmd[61] OR #resetPulse,
	              Feedback := "Paddle06_FB",
	              OverloadOK := "Paddle06_OL",
	              FbTimeout := #FbTimeout,
	              SafeInterlock := #SafeInterlock);

	    #Paddle07(Installed := (#nPad > 6),
	              AutoStart := #Pattern.PaddleCmd[6],
	              AutoStop := #Seq.PaddleAutoStop,
	              Interlock := #Seq.PaddleInterlock,
	              EStop := #EStopLatch,
	              CmdManStart := "DB_HMI".DevCmd[64],
	              CmdManStop := "DB_HMI".DevCmd[65],
	              CmdReturnAuto := "DB_HMI".DevCmd[66],
	              CmdEnable := "DB_HMI".DevCmd[67],
	              CmdDisable := "DB_HMI".DevCmd[68],
	              CmdResetFault := "DB_HMI".DevCmd[69] OR #resetPulse,
	              Feedback := "Paddle07_FB",
	              OverloadOK := "Paddle07_OL",
	              FbTimeout := #FbTimeout,
	              SafeInterlock := #SafeInterlock);
	END_REGION

	REGION Outputs
	    "Blower01_Run" := #Blower01.Run;
	    "Screw01_Run" := #Screw01.Run;
	    "Paddle01_Run" := #Paddle01.Run;
	    "Paddle02_Run" := #Paddle02.Run;
	    "Paddle03_Run" := #Paddle03.Run;
	    "Paddle04_Run" := #Paddle04.Run;
	    "Paddle05_Run" := #Paddle05.Run;
	    "Paddle06_Run" := #Paddle06.Run;
	    "Paddle07_Run" := #Paddle07.Run;

	    #AnyFault := #Blower01.Status.Fault OR #Screw01.Status.Fault
	                 OR #Paddle01.Status.Fault
	                 OR #Paddle02.Status.Fault
	                 OR #Paddle03.Status.Fault
	                 OR #Paddle04.Status.Fault
	                 OR #Paddle05.Status.Fault
	                 OR #Paddle06.Status.Fault
	                 OR #Paddle07.Status.Fault;
	    "Lamp_AutoRun" := #Seq.AutoMode;
	    "Lamp_Fault" := #AnyFault OR #LevelSensorFault;
	    "Lamp_EStop" := #EStopLatch;
	END_REGION

	REGION Silo level and fill request
	    #LevelPct := "FC_ScaleAnalog"(Raw := "Silo_Level_AI", EngLow := 0.0, EngHigh := 100.0,
	                                  Fault => #LevelSensorFault);
	    // request raw material for the silo (hysteresis), never on a broken sensor
	    IF #LevelSensorFault THEN
	        #FillReq := FALSE;
	    ELSIF #LevelPct < #FillOnLevel THEN
	        #FillReq := TRUE;
	    ELSIF #LevelPct >= #FillOffLevel THEN
	        #FillReq := FALSE;
	    END_IF;
	    "Fill_Request" := #FillReq;
	END_REGION

	REGION Status to HMI
	    "DB_HMI".Dev[0] := #Blower01.Status;
	    "DB_HMI".Dev[1] := #Screw01.Status;
	    "DB_HMI".Dev[2] := #Paddle01.Status;
	    "DB_HMI".Dev[3] := #Paddle02.Status;
	    "DB_HMI".Dev[4] := #Paddle03.Status;
	    "DB_HMI".Dev[5] := #Paddle04.Status;
	    "DB_HMI".Dev[6] := #Paddle05.Status;
	    "DB_HMI".Dev[7] := #Paddle06.Status;
	    "DB_HMI".Dev[8] := #Paddle07.Status;

	    "DB_HMI".Sys.AutoMode := #Seq.AutoMode;
	    "DB_HMI".Sys.ExtRequest := #extReq;
	    "DB_HMI".Sys.PatternActive := #Pattern.Active;
	    "DB_HMI".Sys.EStop := #EStopLatch;

	    "DB_HMI".Proc.CurrentStep := #Pattern.CurrentStep;
	    "DB_HMI".Proc.StepElapsed := #Pattern.ElapsedTenths;
	    "DB_HMI".Proc.SiloLevel := REAL_TO_INT(#LevelPct * 10.0);
	END_REGION

	REGION Acknowledge HMI pulse commands
	    // every command acts once; Cmd.ExtRequest is a maintained signal and stays
	    "DB_HMI".Cmd.AutoStart := FALSE;
	    "DB_HMI".Cmd.AutoStop := FALSE;
	    "DB_HMI".Cmd.EStop := FALSE;
	    "DB_HMI".Cmd.ResetEStop := FALSE;
	    FOR #i := 0 TO 71 DO
	        "DB_HMI".DevCmd[#i] := FALSE;
	    END_FOR;
	END_REGION

END_FUNCTION_BLOCK
